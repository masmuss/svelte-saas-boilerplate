{
	// One-time setup per machine: install the ESLint extension from Zed's extension panel (cmd-shift-x).
	// Use project-local Prettier through Bun so editor formatting matches `bun run lint`.
	"format_on_save": "on",
	"languages": {
		"JavaScript": {
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["x", "prettier", "--stdin-filepath", "{buffer_path}"]
				}
			},
			"code_actions_on_format": {
				"source.fixAll.eslint": true
			}
		},
		"TypeScript": {
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["x", "prettier", "--stdin-filepath", "{buffer_path}"]
