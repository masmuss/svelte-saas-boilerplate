# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5433/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# App
PUBLIC_APP_NAME="Svelte Boilerplate"

# Email
# `console` logs messages in dev. Use `resend` in production.
EMAIL_PROVIDER="console"
EMAIL_FROM="App <noreply@example.com>"

# Required only when EMAIL_PROVIDER is "resend"
RESEND_API_KEY=""
